# UniSports Production Environment Variables Template
# Copy these values into your Vercel Project Dashboard (Settings > Environment Variables)

# Django Core Settings
SECRET_KEY=generate-a-strong-random-50-character-string-for-production
DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# MongoDB Atlas Connection
# Note: Whitelist 0.0.0.0/0 in MongoDB Atlas Network Access so Vercel serverless IPs can connect
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/unisports_db?retryWrites=true&w=majority
MONGO_DB_NAME=unisports_db
USE_MONGOMOCK=False
ALLOW_MOCK_FALLBACK=False

# Admin Credentials (used by seed_db.py or system setup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@unisports.edu.in
ADMIN_PASSWORD=change_this_to_a_strong_password

